{
  "name": "classinteract-ai",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "ClassInteract AI – Smart Classroom Engagement & Analytics Platform",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @classinteract/web dev",
    "dev:api": "pnpm --filter @classinteract/api dev",
    "emulators": "firebase emulators:start --project demo-classinteract --only auth,firestore",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:emulator": "firebase emulators:exec --project demo-classinteract --only auth,firestore \"pnpm -r test:integration && pnpm --filter @classinteract/tests test:rules\"",
    "test:e2e": "firebase emulators:exec --project demo-classinteract --only auth,firestore \"pnpm --filter @classinteract/tests test:e2e\"",
    "seed": "pnpm --filter @classinteract/api seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "firebase-tools": "^14.27.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
