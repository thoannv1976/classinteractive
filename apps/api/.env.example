# Local development against the Firebase Emulator Suite
GCLOUD_PROJECT=demo-classinteract
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=8081
# One-time token for POST /api/v1/setup/bootstrap (creates the first super admin)
SETUP_TOKEN=change-me
# Comma separated list of allowed browser origins (only needed when web and API are on different origins)
CORS_ORIGINS=http://localhost:5173
# AI provider keys (in production these come from Secret Manager)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Set to 1 to use a deterministic fake AI provider (tests / demo without keys)
AI_FAKE_PROVIDER=0
