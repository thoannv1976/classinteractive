# Firebase web config (Firebase console → Project settings → Your apps). Public values, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=classinteractive.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=classinteractive
VITE_FIREBASE_APP_ID=
# Local development: use the Firebase Emulator Suite
VITE_USE_EMULATORS=true
# Optional: API base URL when not served from the same origin (default: /api/v1)
VITE_API_BASE=/api/v1
